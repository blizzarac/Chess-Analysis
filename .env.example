# ---- copy to .env and edit ------------------------------------------------------------------
DOMAIN=chess.example.com
BASE_URL=https://chess.example.com

# chess.com asks for a contact address in the User-Agent of API clients.
CHESSCOM_USER_AGENT=chess-analysis/0.2 (contact: you@example.com)
CONTACT_EMAIL=you@example.com

# Who may use the admin endpoints (comma separated emails).
ADMIN_EMAILS=you@example.com

# Sign-in emails. Any SMTP provider works (Postmark, Mailgun, SES, Fastmail, ...).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Chess Report <no-reply@chess.example.com>
SMTP_STARTTLS=1

# Engine: number of Stockfish processes in the worker (leave one core for the web container).
ENGINE_WORKERS=3
ENGINE_HASH_MB=64

# Limits per visitor tier.
ANON_MAX_GAMES=30
ANON_MAX_DEPTH=12
ANON_MAX_MONTHS=12
ANON_JOBS_PER_DAY=5
USER_MAX_GAMES=300
USER_MAX_DEPTH=18
USER_JOBS_PER_DAY=20
IP_REQUESTS_PER_MINUTE=120
LOGIN_LINKS_PER_HOUR=5
CHESSCOM_MIN_INTERVAL=0.4
